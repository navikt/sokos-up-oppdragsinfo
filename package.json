{
	"name": "sokos-up-oppdragsinfo",
	"version": "1.0.0",
	"description": "Oppdragsinfo i Utbetalingsportalen",
	"type": "module",
	"scripts": {
		"dev": "vite --mode mock",
		"dev:backend": "vite --mode backend",
		"build": "tsc && vite build",
		"playwright": "playwright test",
		"biome:check": "biome check --files-ignore-unknown=true",
		"biome:fix": "biome check --write --no-errors-on-unmatched",
		"stylelint:check": "stylelint '**/*.css'",
		"stylelint:fix": "stylelint '**/*.css' --fix",
		"prepare": "husky",
		"pnpm:resolve": "node scripts/resolve-pnpm-version.mjs"
	},
	"dependencies": {
		"@hookform/resolvers": "5.9.1",
		"@navikt/aksel-icons": "8.18.0",
		"@navikt/ds-css": "8.18.0",
		"@navikt/ds-react": "8.18.0",
		"axios": "1.20.0",
		"dayjs": "1.11.23",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"react-hook-form": "7.89.0",
		"react-router": "8.4.0",
		"swr": "2.5.1",
		"zod": "4.6.5",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@biomejs/biome": "2.5.14",
		"@navikt/aksel-stylelint": "8.18.0",
		"@playwright/test": "1.63.0",
		"@types/node": "26.6.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.1",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"msw": "3.0.0",
		"stylelint": "17.15.0",
		"stylelint-config-standard": "40.0.0",
		"typescript": "7.0.2",
		"vite": "8.3.3",
		"vite-plugin-css-injected-by-js": "5.0.2"
	},
	"msw": {
		"workerDirectory": [
			"public"
		]
	},
	"stylelint": {
		"extends": [
			"stylelint-config-standard",
			"@navikt/aksel-stylelint/recommended"
		],
		"rules": {
			"aksel/design-token-no-global-override": [
				true,
				{
					"severity": "warning"
				}
			],
			"selector-class-pattern": null,
			"custom-property-pattern": "[a-z][a-zA-Z0-9-]+"
		},
		"ignoreFiles": [
			"dist/**/*",
			"playwright-report/**/*"
		]
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc}": "biome check --write --no-errors-on-unmatched",
		"*.css": "stylelint --fix"
	},
	"engines": {
		"pnpm": ">=11.28.4",
		"node": ">=24.14.1"
	},
	"packageManager": "pnpm@11.28.4+sha512.f905a61563f89b49a292634d3d87d024cfdea9dccf5c66b2ccc261675fa7b2774320a959db472e6caa7f9ff7314709cd50d06c8fd64addb60647377a78d250ff"
}
